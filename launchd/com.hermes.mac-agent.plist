<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.mac-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>hermes_mac_agent.daemon.server</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HERMES_MAC_AGENT_HOME</key>
        <string>__CONFIG_DIR__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__CONFIG_DIR__/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>__CONFIG_DIR__/daemon.err.log</string>
</dict>
</plist>
